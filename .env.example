# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.

# Supabase Project URL  -> Project Settings -> API
# Supabase anon / public API key (safe to ship to the browser).
# Without these the blog falls back to its local seed file and the admin
# panel shows a "Supabase not configured" state.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Admin sign-in uses Supabase Auth. Run supabase/admin-security.sql first.
# The anon key is fine here; the service_role key is NOT and must never
# appear in a client-side or committed file.

# Contact form delivery (Resend).
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
CONTACT_FROM_EMAIL=""

# Public URL of the deployed site, no trailing slash, e.g. https://yourdomain.com
# Required at build time: it fills every canonical, Open Graph and sitemap URL,
# and those tags are ignored by Google if they are relative or wrong.
SITE_URL=""
